# ============================================================
# MathCyclus .gitignore（UTF-8）
# 原则：源码、schema、脚本、模板、文档进 Git；
#       密钥、题库私有数据、本地数据库、导出产物、缓存不进 Git。
# ============================================================

# ---------- 密钥与配置（绝对不能上传） ----------
.env
.env.*
!.env.example
env.local
.streamlit/secrets.toml
.agently-auth/

# ---------- 题库私有数据（版权与体积风险，仅存本地） ----------
# 题库 LaTeX 源文件与题图，本地保留，不入库
chapters/
# 用户生成的组卷导出文件（主题模板仍入库）
Test Paper Group/导出文件/
exports/
# 本地数据库、图片资源、导入中间产物、备份
data/
assets/questions/
backups/
reports/
.backups/
# 题库本地索引与统计（每台电脑独立生成，可重建）
utils/题库索引表.csv
utils/semantic_index.sqlite3
utils/local_stats.sqlite3
utils/local_stats.sqlite3-*
utils/operation_log.sqlite3
utils/operation_log.sqlite3-*

# ---------- 运行日志与临时产物 ----------
log.csv
debug.log
更新信息.txt
ocr的备份.txt
.sync-work-*/
.codex/
.agents/
tatus --short
test_ocr_question.png

# ---------- 编译与渲染缓存 ----------
.tikz_cache/
*.pdf
*.synctex.gz
*.aux
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.xdv
*.log

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db

# ---------- 历史备份与外部参考 ----------
question_bank_app000.py
old_app.py
SolaireEPDA-master/
高中数学建模15课时课程设计.md
MathCyclus_demo.html
AutoTikz.md
cloze_exports/

# ---------- 独立前端实验工作区 ----------
tiku/

# ---------- 本地 UI 验证产物 ----------
.edge-test-profile/
.ui-check.png
.dom-check.html
.streamlit-test.log
fix_codex_config.py
